///|
/// Basic AGCA compatibility front doors for polynomial ideals and maps.
///
/// Current Limits:
/// - this file exposes finitely generated ideals and simple ring homomorphisms
///   only.
/// - ideal operations are implemented through the current Groebner-based
///   compatibility surface.

///|
/// A finitely generated ideal inside a polynomial ring.
///
/// - Does: Stores one generating set for an ideal in a fixed polynomial ring.
/// - Input: Built from a non-empty `Array[Poly]`.
/// - Returns: An `Ideal`.
/// - Limits: All generators must share the same ring domain and generators.
pub struct Ideal {
  gens : Array[Poly]
}

///|
/// Build an ideal from generators.
///
/// - Does: Validates that the generators belong to one polynomial ring and
///   stores them as an ideal.
/// - Input: `Array[Poly]`.
/// - Returns: An `Ideal`.
/// - Limits: Raises `PolyError::NonPolynomial` for empty input and
///   `PolyError::DomainMismatch` for mixed rings.
pub fn ideal(gens : Array[Poly]) -> Ideal raise PolyError {
  if gens.is_empty() {
    raise PolyError::NonPolynomial
  }
  let base = gens[0]
  for g in gens {
    if g.domain.not_equal(base.domain) || g.gens != base.gens {
      raise PolyError::DomainMismatch
    }
  }
  Ideal::{ gens, }
}

///|
/// Return the coefficient domain of the ambient ring.
///
/// - Does: Exposes the common coefficient domain of the ideal generators.
/// - Input: An `Ideal`.
/// - Returns: A `Domain`.
/// - Limits: Assumes the ideal has already passed constructor validation.
pub fn Ideal::ring_domain(self : Ideal) -> Domain {
  self.gens[0].domain
}

///|
/// Return the generators of the ambient polynomial ring.
///
/// - Does: Exposes the shared polynomial variables of the ideal generators.
/// - Input: An `Ideal`.
/// - Returns: `Array[String]`.
/// - Limits: Assumes the ideal has already passed constructor validation.
pub fn Ideal::ring_gens(self : Ideal) -> Array[String] {
  self.gens[0].gens
}

///|
fn ideal_check_compatible(lhs : Ideal, rhs : Ideal) -> Unit raise PolyError {
  if lhs.ring_domain().not_equal(rhs.ring_domain()) ||
    lhs.ring_gens() != rhs.ring_gens() {
    raise PolyError::DomainMismatch
  }
}

///|
fn ideal_groebner_basis(idl : Ideal) -> Array[Poly] raise PolyError {
  let nonzero = idl.gens.filter(g => !g.is_zero())
  if nonzero.is_empty() {
    [Poly::zero(idl.ring_gens(), idl.ring_domain())]
  } else {
    Poly::groebner(nonzero, order=TermOrder::Lex)
  }
}

///|
/// Form the sum of two ideals.
///
/// - Does: Returns the ideal generated by the union of both generator sets.
/// - Input: Two compatible `Ideal` values.
/// - Returns: An `Ideal`.
/// - Limits: Raises `PolyError::DomainMismatch` when the ambient rings differ.
pub fn Ideal::sum(self : Ideal, other : Ideal) -> Ideal raise PolyError {
  ideal_check_compatible(self, other)
  let out = self.gens.copy()
  for g in other.gens {
    out.push(g)
  }
  Ideal::{ gens: out }
}

///|
/// Form the product of two ideals.
///
/// - Does: Returns the ideal generated by pairwise products of generators.
/// - Input: Two compatible `Ideal` values.
/// - Returns: An `Ideal`.
/// - Limits: Raises `PolyError::DomainMismatch` when the ambient rings differ.
pub fn Ideal::product(self : Ideal, other : Ideal) -> Ideal raise PolyError {
  ideal_check_compatible(self, other)
  let out : Array[Poly] = Array::new()
  for a in self.gens {
    for b in other.gens {
      out.push(a.mul(b))
    }
  }
  Ideal::{ gens: out }
}

///|
/// Alias for the ideal sum.
///
/// - Does: Preserves the `union` compatibility spelling.
/// - Input: Two compatible `Ideal` values.
/// - Returns: An `Ideal`.
/// - Limits: Shares the same restrictions as `Ideal::sum`.
pub fn Ideal::union(self : Ideal, other : Ideal) -> Ideal raise PolyError {
  self.sum(other)
}

///|
/// Reduce a polynomial modulo the ideal.
///
/// - Does: Returns the reduced remainder of `poly` modulo a Groebner basis of
///   the ideal.
/// - Input: An `Ideal` and a `Poly` from the same ring.
/// - Returns: A `Poly`.
/// - Limits: Raises `PolyError::DomainMismatch` when the polynomial is from a
///   different ring.
pub fn Ideal::reduce_element(self : Ideal, poly : Poly) -> Poly raise PolyError {
  if poly.domain.not_equal(self.ring_domain()) || poly.gens != self.ring_gens() {
    raise PolyError::DomainMismatch
  }
  let basis = ideal_groebner_basis(self)
  reduced(poly, basis).1
}

///|
/// Test ideal membership.
///
/// - Does: Checks whether `poly` reduces to zero modulo a Groebner basis of the
///   ideal.
/// - Input: An `Ideal` and a `Poly`.
/// - Returns: A `Bool`.
/// - Limits: Raises `PolyError` when reduction cannot be performed in the same
///   ring.
pub fn Ideal::contains(self : Ideal, poly : Poly) -> Bool raise PolyError {
  if poly.is_zero() {
    return true
  }
  self.reduce_element(poly).is_zero()
}

///|
/// Raise an ideal to a non-negative power.
///
/// - Does: Computes `self^n`, with `n = 0` yielding the unit ideal.
/// - Input: An `Ideal` and non-negative exponent `Int`.
/// - Returns: An `Ideal`.
/// - Limits: Raises `PolyError::BadExponent` for negative exponents.
pub fn Ideal::power(self : Ideal, n : Int) -> Ideal raise PolyError {
  if n < 0 {
    raise PolyError::BadExponent
  }
  if n == 0 {
    return Ideal::{ gens: [Poly::one(self.ring_gens(), self.ring_domain())] }
  }
  let mut out = self
  for _ in 1..<n {
    out = out.product(self)
  }
  out
}

///|
/// Intersect two ideals.
///
/// - Does: Computes the intersection using the standard elimination
///   construction.
/// - Input: Two compatible `Ideal` values.
/// - Returns: An `Ideal`.
/// - Limits: Raises `PolyError::DomainMismatch` when the ambient rings differ.
pub fn Ideal::intersect(self : Ideal, other : Ideal) -> Ideal raise PolyError {
  ideal_check_compatible(self, other)
  let aux = "__agca_t"
  let ext_gens = [aux]
  for g in self.ring_gens() {
    ext_gens.push(g)
  }
  let builder = PolyBuilder::new(ext_gens, self.ring_domain())
  let t = Expr::Symbol(aux)
  let one = int(1)
  let elim_gens : Array[Poly] = Array::new()
  for f in self.gens {
    elim_gens.push(builder.from_expr(t * f.to_expr()))
  }
  for g in other.gens {
    elim_gens.push(builder.from_expr((one - t) * g.to_expr()))
  }
  let basis = Poly::groebner(elim_gens, order=TermOrder::Lex)
  let ring_builder = PolyBuilder::new(self.ring_gens(), self.ring_domain())
  let out : Array[Poly] = Array::new()
  for g in basis {
    if agca_free_of_aux(g) {
      out.push(ring_builder.from_expr(g.to_expr()))
    }
  }
  if out.is_empty() {
    Ideal::{ gens: [Poly::zero(self.ring_gens(), self.ring_domain())] }
  } else {
    Ideal::{ gens: out }
  }
}

///|
/// Test whether the ideal is the zero ideal.
///
/// - Does: Checks whether every stored generator is zero.
/// - Input: An `Ideal`.
/// - Returns: A `Bool`.
/// - Limits: This reflects the stored generating set only.
pub fn Ideal::is_zero(self : Ideal) -> Bool {
  self.gens.all(g => g.is_zero())
}

///|
/// Test whether the ideal is the whole ring.
///
/// - Does: Checks whether the ideal contains the multiplicative identity.
/// - Input: An `Ideal`.
/// - Returns: A `Bool`.
/// - Limits: Raises `PolyError` when the membership test cannot be completed.
pub fn Ideal::is_whole_ring(self : Ideal) -> Bool raise PolyError {
  self.contains(Poly::one(self.ring_gens(), self.ring_domain()))
}

///|
fn agca_free_of_aux(poly : Poly) -> Bool {
  for m, _ in poly.coeffs {
    if !m.exps.is_empty() && m.exps[0] != 0 {
      return false
    }
  }
  true
}

///|
/// Polynomial ring homomorphism by generator substitution.
///
/// - Does: Stores an image for each source generator into a target ring.
/// - Input: Source generators, target generators, target domain, and generator
///   image map.
/// - Returns: A `RingHomomorphism`.
/// - Limits: Every source generator must appear in the image map.
pub struct RingHomomorphism {
  source_gens : Array[String]
  target_gens : Array[String]
  target_domain : Domain
  image : Map[String, Expr]
}

///|
/// Build a polynomial ring homomorphism.
///
/// - Does: Validates the generator image map and stores the homomorphism data.
/// - Input: Source generators, target generators, target domain, and generator
///   image map.
/// - Returns: A `RingHomomorphism`.
/// - Limits: Raises `PolyError::BadGenerator` when a source generator has no
///   assigned image.
pub fn ring_homomorphism(
  source_gens : Array[String],
  target_gens : Array[String],
  target_domain : Domain,
  image : Map[String, Expr],
) -> RingHomomorphism raise PolyError {
  for g in source_gens {
    if image.get(g) is None {
      raise PolyError::BadGenerator(g)
    }
  }
  RingHomomorphism::{ source_gens, target_gens, target_domain, image }
}

///|
/// Apply the homomorphism to an expression.
///
/// - Does: Substitutes each source generator by its mapped image.
/// - Input: A `RingHomomorphism` and `Expr`.
/// - Returns: An `Expr`.
/// - Limits: This does not check whether the input uses only source generators.
pub fn RingHomomorphism::apply_expr(
  self : RingHomomorphism,
  expr : Expr,
) -> Expr {
  @symcore.subst(expr, self.image)
}

///|
/// Apply the homomorphism to a polynomial.
///
/// - Does: Converts the polynomial to an expression, applies the substitution,
///   and rebuilds a polynomial in the target ring.
/// - Input: A `RingHomomorphism` and `Poly`.
/// - Returns: A `Poly`.
/// - Limits: Raises `PolyError::BadGenerator` when the polynomial ring does not
///   match the homomorphism source generators.
pub fn RingHomomorphism::apply_poly(
  self : RingHomomorphism,
  poly : Poly,
) -> Poly raise PolyError {
  if poly.gens != self.source_gens {
    raise PolyError::BadGenerator(poly.gens.join(","))
  }
  let mapped = self.apply_expr(poly.to_expr())
  PolyBuilder::new(self.target_gens, self.target_domain).from_expr(mapped)
}
